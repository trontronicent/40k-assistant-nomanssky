{
  "$schema": "https://raw.githubusercontent.com/trontronicent/40k-assistant-plugins/main/schema/plugin-manifest.schema.json",
  "manifest_version": 1,
  "id": "nomanssky",
  "name": "No Man's Sky",
  "version": "0.2.0",
  "description": "Connector to No Man's Sky: reads your save files and shows location, inventories (with the game's item names and icons), ships, bases and how often the game saves.",
  "author": {
    "name": "TronTronicEnt",
    "url": "https://github.com/trontronicent"
  },
  "license": "MIT",
  "app": {
    "min_version": "3.1.0",
    "plugin_api": 2
  },
  "contributes": {
    "backend": {
      "module": "nms_connector",
      "entry": "create_plugin",
      "permissions": ["read-game-files", "network"]
    }
  }
}
