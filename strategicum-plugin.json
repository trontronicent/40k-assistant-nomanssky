{
  "$schema": "https://raw.githubusercontent.com/trontronicent/40k-assistant-plugins/main/schema/plugin-manifest.schema.json",
  "manifest_version": 1,
  "id": "nomanssky",
  "name": "No Man's Sky",
  "version": "0.4.1",
  "description": "Connector to No Man's Sky: save data (location, inventories with item names and icons, ships, bases), every visited system on a clickable map, and - read live from the running game - planets, resources and gas.",
  "author": {
    "name": "TronTronicEnt",
    "url": "https://github.com/trontronicent"
  },
  "license": "MIT",
  "app": {
    "min_version": "3.3.0",
    "plugin_api": 2
  },
  "contributes": {
    "backend": {
      "module": "nms_connector",
      "entry": "create_plugin",
      "permissions": ["read-game-files", "read-game-memory", "network"]
    }
  }
}
